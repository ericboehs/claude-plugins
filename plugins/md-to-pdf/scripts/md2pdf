#!/usr/bin/env bash
# md2pdf — convert GitHub-flavored markdown to a GitHub-styled PDF
# Usage: md2pdf input.md [output.pdf]
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: md2pdf input.md [output.pdf]" >&2
  exit 1
fi

input="$1"
output="${2:-${input%.md}.pdf}"

# Resolve symlinks before locating the bundled CSS: this script is meant to be
# linked onto PATH (e.g. ~/.local/bin/md2pdf), and a bare dirname of $0 would
# point at the link's directory, not the plugin's. BSD readlink has no -f.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
here="$(cd -P "$(dirname "$src")" && pwd)"
print_css="$here/../assets/github-print.css"

# github-markdown-css is MIT but 22 KB of vendored third-party CSS, so it is
# fetched once and cached rather than committed. Override the theme with
# MD2PDF_THEME=dark.
theme="${MD2PDF_THEME:-light}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/md2pdf"
base_css="$cache/github-markdown-$theme.css"

command -v pandoc >/dev/null || { echo "Missing pandoc — brew install pandoc" >&2; exit 1; }

# Chrome does the actual rendering; the print CSS is written against its
# engine. Take whichever build is installed.
chrome=""
for candidate in \
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
  "/Applications/Chromium.app/Contents/MacOS/Chromium" \
  "/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary" \
  google-chrome chromium chromium-browser; do
  if [[ -x "$candidate" ]] || command -v "$candidate" >/dev/null 2>&1; then
    chrome="$candidate"
    break
  fi
done
[[ -n "$chrome" ]] || { echo "No Chrome or Chromium found" >&2; exit 1; }

if [[ ! -f "$base_css" ]]; then
  mkdir -p "$cache"
  echo "Fetching github-markdown-css ($theme)..." >&2
  curl -fsSL "https://cdn.jsdelivr.net/npm/github-markdown-css@5/github-markdown-$theme.css" \
    -o "$base_css" || { rm -f "$base_css"; echo "Could not fetch github-markdown-css" >&2; exit 1; }
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

css="$tmpdir/combined.css"
cat "$base_css" "$print_css" > "$css"
if [[ "$theme" == "dark" ]]; then
  printf '\nhtml, body, .markdown-body { background: #0d1117 !important; }\n' >> "$css"
fi

html="$tmpdir/doc.html"

# Pandoc: GFM → standalone HTML, embed CSS and local images inline
pandoc "$input" \
  --from gfm \
  --to html5 \
  --standalone \
  --embed-resources \
  --css "$css" \
  --metadata title="" \
  -V document-css=false \
  --wrap=none \
  -o "$html"

# github-markdown-css scopes every selector to .markdown-body; wrap pandoc's
# <body> content in that class or none of the styling applies.
python3 - "$html" <<'PY'
import sys, re
p = sys.argv[1]
with open(p, 'r', encoding='utf-8') as f:
    html = f.read()
html = re.sub(r'<body([^>]*)>', r'<body\1><article class="markdown-body">', html, count=1)
html = html.replace('</body>', '</article></body>', 1)
with open(p, 'w', encoding='utf-8') as f:
    f.write(html)
PY

"$chrome" \
  --headless=new \
  --disable-gpu \
  --no-pdf-header-footer \
  --print-to-pdf-no-header \
  --print-to-pdf="$output" \
  "file://$html" 2>/dev/null

echo "Wrote: $output"
